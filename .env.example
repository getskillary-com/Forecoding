# ===== Core =====
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME?sslmode=require
NEXTAUTH_URL=https://your-domain.com
NEXTAUTH_SECRET=replace_with_long_random_secret

# ===== Auth / Email Code =====
AUTH_CODE_SECRET=replace_with_long_random_secret
EMAIL_SERVER=smtp://user:password@smtp.example.com:587
EMAIL_FROM=Forecoding <no-reply@example.com>

# ===== AI =====
AI_PROVIDER=claude
GEMINI_API_KEY=replace_with_gemini_key
CLAUDE_API_KEY=replace_with_claude_key
CLAUDE_MODEL=claude-opus-4-6
# Optional:
# ANTHROPIC_API_KEY=
# CLAUDE_API_BASE_URL=https://api.anthropic.com
# CLAUDE_API_VERSION=2023-06-01
# CLAUDE_MAX_TOKENS=8192
# CLAUDE_COOLDOWN_MS=120000

# ===== Stripe =====
STRIPE_SECRET_KEY=sk_live_or_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Dynamic pricing base floor (in cents), used when no Stripe Price is configured:
STRIPE_UNIT_AMOUNT_CENTS=799
# Dynamic pricing cap (in cents):
STRIPE_MAX_UNIT_AMOUNT_CENTS=1499
# Toggle dynamic pricing (1/0):
STRIPE_DYNAMIC_PRICING_ENABLED=1
STRIPE_CURRENCY=usd

# ===== Dev only (optional) =====
NEXTAUTH_DEV_BYPASS=0
NEXT_PUBLIC_DEV_AUTH_BYPASS=0
