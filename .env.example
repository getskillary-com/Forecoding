# ===== Core =====
APP_BASE_URL=https://your-domain.com
DATA_BACKEND_MODE=firebase_only

# ===== Auth / Email Code =====
AUTH_CODE_SECRET=replace_with_long_random_secret
EMAIL_SERVER=smtp://user:password@smtp.example.com:587
EMAIL_FROM=Forecoding <no-reply@example.com>

# ===== Firebase Admin (server-side) =====
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
AUTH_SESSION_COOKIE_NAME=__session

# ===== Firebase Client (browser) =====
NEXT_PUBLIC_FIREBASE_API_KEY=AIza...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef123456
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890

# ===== AI =====
# AI_PROVIDER options: openai | gemini | claude
AI_PROVIDER=gemini
OPENAI_API_KEY=replace_with_openai_key
OPENAI_MODEL=gpt-5-mini
# Optional:
# OPENAI_API_BASE_URL=https://api.openai.com/v1
# OPENAI_MAX_OUTPUT_TOKENS=65536
# OPENAI_REASONING_EFFORT=minimal
GEMINI_API_KEY=replace_with_gemini_key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BACKUP_MODEL=gemini-2.5-flash
CLAUDE_API_KEY=replace_with_claude_key
CLAUDE_MODEL=claude-opus-4-6
# ANTHROPIC_API_KEY=
# CLAUDE_API_BASE_URL=https://api.anthropic.com
# CLAUDE_API_VERSION=2023-06-01
# CLAUDE_MAX_TOKENS=8192
# CLAUDE_COOLDOWN_MS=120000

# ===== Stripe =====
STRIPE_SECRET_KEY=sk_live_or_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Emergency pause switch for all Stripe checkout creation (1/0):
STRIPE_PAYMENTS_PAUSED=0
# Dynamic pricing base floor (in cents), used when no Stripe Price is configured:
STRIPE_UNIT_AMOUNT_CENTS=799
# Dynamic pricing cap (in cents):
STRIPE_MAX_UNIT_AMOUNT_CENTS=1499
# Toggle dynamic pricing (1/0):
STRIPE_DYNAMIC_PRICING_ENABLED=1
STRIPE_CURRENCY=usd

# ===== Admin =====
# Comma/newline/semicolon separated emails, e.g. admin1@x.com,admin2@x.com
FORECODING_ADMIN_EMAILS=admin@example.com

# ===== Optional: legacy PostgreSQL source for one-time migration script =====
# MIGRATION_SOURCE_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME?sslmode=require

# ===== Dev only (optional) =====
NEXT_PUBLIC_DEV_AUTH_BYPASS=0
